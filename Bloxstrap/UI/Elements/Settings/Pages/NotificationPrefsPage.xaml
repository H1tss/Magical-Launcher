<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.NotificationPrefsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="NotificationPrefsPage"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Notifications" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Configure which notifications you want to see." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Update Notifications" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Show notification when a new version is available" Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="UpdateNotifToggle" IsChecked="True" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Error Notifications" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Show notification on errors" Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="ErrorNotifToggle" IsChecked="True" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Launch Notifications" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Show notification when Roblox is launched" Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="LaunchNotifToggle" IsChecked="False" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Discord RPC Notifications" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Show notification when Discord RPC connects/disconnects" Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="DiscordNotifToggle" IsChecked="False" />
            </StackPanel>
        </ui:Card>

        <ui:Button Content="Save" Icon="Save24" Margin="0,8,0,0" Click="Save_Click" />
        <TextBlock x:Name="NotifStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
    </StackPanel>
</ui:UiPage>
