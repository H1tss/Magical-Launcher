<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ModMarketplacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ModMarketplacePage">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Mod Marketplace" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Browse and install community-made mods for Roblox." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Available Mods" Margin="0,0,0,8" />
                <ListView x:Name="ModsList" MaxHeight="400">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Install" Icon="Add24" Click="InstallMod_Click" Tag="{Binding Id}" Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ui:Card>

        <TextBlock x:Name="MarketStatus" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Marketplace coming soon! Community mods will be available here." />
    </StackPanel>
</ui:UiPage>
