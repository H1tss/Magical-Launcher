<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ServerBrowserPage">

    <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="Server Browser" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Browse and join public Roblox servers" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,12">
            <StackPanel Margin="12">
                <TextBlock Text="Game Place ID or URL:" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="PlaceIdInput" Width="400" PlaceholderText="Enter Place ID or Roblox URL" Margin="0,0,8,0" />
                    <ui:Button Content="Load Servers" Appearance="Primary" Click="LoadServers_Click" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,12">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SortCombo" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="Players" />
                        <ComboBoxItem Content="Ping" />
                        <ComboBoxItem Content="FPS" />
                    </ComboBox>
                    <ui:Button Content="Join Empty Server" Appearance="Primary" Click="JoinEmpty_Click" Margin="16,0,0,0" />
                </StackPanel>

                <DataGrid x:Name="ServerList" AutoGenerateColumns="False" Height="300" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Players" Binding="{Binding Players}" Width="80" />
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxPlayers}" Width="60" />
                        <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="80" />
                        <DataGridTextColumn Header="FPS" Binding="{Binding FPS}" Width="60" />
                        <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="100" />
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Join" Click="JoinServer_Click" Tag="{Binding}" Padding="12,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Load More" Click="LoadMore_Click" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</ui:UiPage>