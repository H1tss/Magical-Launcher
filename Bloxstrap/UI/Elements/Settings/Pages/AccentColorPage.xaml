<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccentColorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AccentColorPage"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Accent Color" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Customize the accent color used throughout Magical Launcher." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Preset Colors" Margin="0,0,0,8" />
                <WrapPanel>
                    <ui:Button Content="Pink (Default)" Tag="#FF69B4" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Purple" Tag="#9B59B6" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Blue" Tag="#3498DB" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Cyan" Tag="#1ABC9C" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Red" Tag="#E74C3C" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Orange" Tag="#E67E22" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Yellow" Tag="#F1C40F" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="Green" Tag="#2ECC71" Click="PresetColor_Click" Margin="0,0,8,8" />
                    <ui:Button Content="White" Tag="#FFFFFF" Click="PresetColor_Click" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Custom Color" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="CustomColorInput" Width="120" PlaceholderText="#FF69B4" Margin="0,0,8,0" />
                    <ui:Button Content="Apply" Icon="Checkmark24" Click="ApplyCustomColor_Click" Margin="0,0,8,0" />
                    <Border x:Name="ColorPreview" Width="40" Height="40" CornerRadius="8" Background="#FF69B4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Current Color" Margin="0,0,0,8" />
                <Border x:Name="CurrentColorBorder" Width="60" Height="60" CornerRadius="12" Background="#FF69B4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
            </StackPanel>
        </ui:Card>

        <ui:Button x:Name="ResetBtn" Content="Reset to Default Pink" Icon="ArrowUndo24" Margin="0,8,0,0" Click="Reset_Click" />
        <TextBlock x:Name="ColorStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
    </StackPanel>
</ui:UiPage>
