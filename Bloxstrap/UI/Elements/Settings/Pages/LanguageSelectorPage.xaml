<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.LanguageSelectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="LanguageSelectorPage"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Language" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Choose your preferred language for Magical Launcher." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Select Language" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Restart required after changing language" Margin="0,0,0,8" />
                <ComboBox x:Name="LanguageCombo" Width="250" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en" IsSelected="True" />
                    <ComboBoxItem Content="Spanish" Tag="es" />
                    <ComboBoxItem Content="French" Tag="fr" />
                    <ComboBoxItem Content="German" Tag="de" />
                    <ComboBoxItem Content="Japanese" Tag="ja" />
                    <ComboBoxItem Content="Korean" Tag="ko" />
                    <ComboBoxItem Content="Portuguese" Tag="pt" />
                    <ComboBoxItem Content="Russian" Tag="ru" />
                    <ComboBoxItem Content="Chinese (Simplified)" Tag="zh" />
                </ComboBox>
            </StackPanel>
        </ui:Card>

        <TextBlock x:Name="LanguageStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
    </StackPanel>
</ui:UiPage>
