<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.BanAsyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="BanAsyncPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Ban Trace Cleanup" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
            <TextBlock Text="Clean Roblox traces, spoof MAC addresses, and randomize MachineGuid" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Trace Cleanup" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Wipe Roblox caches, logs, and registry entries" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="12">
                    <CheckBox x:Name="PreserveSettings" Content="Preserve in-game settings" IsChecked="True" Margin="0,4" />
                    <CheckBox x:Name="PreserveFFlags" Content="Preserve FastFlags" IsChecked="True" Margin="0,4" />
                    <CheckBox x:Name="IncludeStudio" Content="Include Studio folders" Margin="0,4" />
                    <CheckBox x:Name="WipeInstalls" Content="Wipe downloaded installs" Margin="0,4" />
                    <CheckBox x:Name="ClearCookies" Content="Clear browser cookies" Margin="0,4" />
                    <ui:Button Content="Clean Traces Now" Appearance="Danger" Click="CleanTraces_Click" Margin="0,8,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,0,0,8">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="MAC Address Spoofing" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Randomize your network adapter MAC address" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="12">
                    <TextBlock Text="Select Adapter:" Margin="0,0,0,4" />
                    <ComboBox x:Name="AdapterCombo" Width="300" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="OUIMirror" Content="OUI Mirror" Margin="0,0,16,0" />
                        <CheckBox x:Name="DHCPRefresh" Content="DHCP Refresh" Margin="0,0,16,0" />
                        <CheckBox x:Name="PersistentSpoof" Content="Persistent" />
                    </StackPanel>
                    <TextBlock Text="Current MAC:" Margin="0,8,0,4" />
                    <TextBlock x:Name="CurrentMAC" Text="Not detected" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="Spoof MAC" Appearance="Primary" Click="SpoofMAC_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Revert MAC" Click="RevertMAC_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,0,0,8">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="MachineGuid Randomization" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Randomize your Windows MachineGuid" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="12">
                    <CheckBox x:Name="AckRisk" Content="I understand the risks" Margin="0,0,0,8" />
                    <TextBlock Text="Current MachineGuid:" Margin="0,0,0,4" />
                    <TextBlock x:Name="CurrentGuid" Text="Not loaded" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="Randomize" Appearance="Primary" Click="RandomizeGuid_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Restore Backup" Click="RestoreGuid_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <ui:Card Margin="0,0,0,8">
                <StackPanel Margin="12">
                    <TextBlock Text="Activity Log" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                    <ListBox x:Name="ActivityLog" Height="150" FontSize="11" />
                    <ui:Button Content="Clear Log" Click="ClearLog_Click" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>