<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.PortableModePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="PortableModePage">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Portable Mode" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Run Magical Launcher without installing to your system." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Enable Portable Mode" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Store all settings and data in the same folder as the executable instead of AppData." Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="PortableToggle" IsChecked="False" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Current Data Location" Margin="0,0,0,4" />
                <TextBlock x:Name="DataLocation" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Button Content="Save" Icon="Save24" Margin="0,8,0,0" Click="Save_Click" />
        <TextBlock x:Name="PortableStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</ui:UiPage>
