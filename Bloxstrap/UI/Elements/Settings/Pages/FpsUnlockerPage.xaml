<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FpsUnlockerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="FpsUnlockerPage"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="FPS Unlocker" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Unlock Roblox's frame rate cap for smoother gameplay." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Enable FPS Unlocker" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Removes the 60 FPS cap. Requires FastFlag modifications." Margin="0,0,0,8" />
                <ui:ToggleSwitch x:Name="FpsUnlockToggle" IsChecked="False" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Target FPS" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Set a maximum frame rate (0 = unlimited)" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="60" Tag="60" Click="FpsPreset_Click" Margin="0,0,8,8" Padding="12,4" />
                    <ui:Button Content="120" Tag="120" Click="FpsPreset_Click" Margin="0,0,8,8" Padding="12,4" />
                    <ui:Button Content="144" Tag="144" Click="FpsPreset_Click" Margin="0,0,8,8" Padding="12,4" />
                    <ui:Button Content="240" Tag="240" Click="FpsPreset_Click" Margin="0,0,8,8" Padding="12,4" />
                    <ui:Button Content="Unlimited" Tag="0" Click="FpsPreset_Click" Margin="0,0,8,8" Padding="12,4" />
                </StackPanel>
                <ui:TextBox x:Name="CustomFpsInput" Width="120" PlaceholderText="Custom FPS" Margin="0,0,8,0" />
            </StackPanel>
        </ui:Card>

        <ui:Button Content="Save" Icon="Save24" Margin="0,8,0,0" Click="Save_Click" />
        <TextBlock x:Name="FpsStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
    </StackPanel>
</ui:UiPage>
