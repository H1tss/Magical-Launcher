<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.LaunchArgsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="LaunchArgsPage"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Launch Arguments" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Add custom command-line arguments for launching Roblox." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Custom Arguments" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="One argument per line. These will be passed to Roblox when launching." Margin="0,0,0,8" />
                <ui:TextBox x:Name="ArgsInput" AcceptsReturn="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PlaceholderText="-debug -disableSocialService" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Common Arguments" Margin="0,0,0,8" />
                <WrapPanel>
                    <ui:Button Content="-m" Tag="-m" Click="QuickArg_Click" Margin="0,0,8,8" Padding="8,4" />
                    <ui:Button Content="-b" Tag="-b" Click="QuickArg_Click" Margin="0,0,8,8" Padding="8,4" />
                    <ui:Button Content="-disableSocialService" Tag="-disableSocialService" Click="QuickArg_Click" Margin="0,0,8,8" Padding="8,4" />
                    <ui:Button Content="-disablePerformanceStats" Tag="-disablePerformanceStats" Click="QuickArg_Click" Margin="0,0,8,8" Padding="8,4" />
                    <ui:Button Content="-disableAppStoreApp" Tag="-disableAppStoreApp" Click="QuickArg_Click" Margin="0,0,8,8" Padding="8,4" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:Button Content="Save Arguments" Icon="Save24" Margin="0,8,0,0" Click="Save_Click" />
        <TextBlock x:Name="ArgsStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
    </StackPanel>
</ui:UiPage>
