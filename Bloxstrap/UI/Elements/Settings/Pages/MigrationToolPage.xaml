<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.MigrationToolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="MigrationToolPage">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Migration Tool" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
        <TextBlock Text="Import settings and configurations from other bootstrappers." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Import from Bloxstrap" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Import settings, Fast Flags, and mods from a Bloxstrap installation." Margin="0,0,0,8" />
                <ui:Button Content="Import from Bloxstrap" Icon="ArrowImport24" Click="ImportBloxstrap_Click" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Import Settings File" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Import a settings JSON file from another bootstrapper." Margin="0,0,0,8" />
                <ui:Button Content="Import File" Icon="ArrowImport24" Click="ImportFile_Click" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="Export Settings" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Export your current settings to share with others." Margin="0,0,0,8" />
                <ui:Button Content="Export Settings" Icon="ArrowExportUp24" Click="ExportSettings_Click" />
            </StackPanel>
        </ui:Card>

        <TextBlock x:Name="MigrationStatus" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</ui:UiPage>
