<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AltGenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AltGenPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Alt Account Generator" FontSize="24" FontWeight="Medium" Margin="0,0,0,4" Foreground="#FF69B4" />
            <TextBlock Text="Generate Roblox alt accounts using BloxGen API" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

            <ui:InfoBar Title="Third-Party Service" Severity="Informational" IsOpen="True" Margin="0,0,0,12">
                <TextBlock Text="This uses BloxGen API. You need an API key from bloxgen.net" TextWrapping="Wrap" />
            </ui:InfoBar>

            <ui:Card Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <TextBlock Text="BloxGen API Key:" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="ApiKeyInput" Width="350" PlaceholderText="Enter your API key" Margin="0,0,8,0" />
                        <ui:Button Content="Save" Click="SaveKey_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <TextBlock Text="Account Type:" Margin="0,0,0,4" />
                    <ComboBox x:Name="AltTypeCombo" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Normal Account" />
                        <ComboBoxItem Content="Bot Account" />
                    </ComboBox>
                    <ui:Button Content="Generate Alt" Appearance="Primary" Click="GenerateAlt_Click" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="ResultCard" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <TextBlock Text="Generated Account" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Text="Username:" Margin="0,0,0,2" />
                    <TextBlock x:Name="ResultUsername" Text="-" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Password:" Margin="0,0,0,2" />
                    <TextBlock x:Name="ResultPassword" Text="-" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text=".ROBLOSECURITY:" Margin="0,0,0,2" />
                    <TextBox x:Name="ResultCookie" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Copy Username" Click="CopyUser_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Copy Password" Click="CopyPass_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Copy Cookie" Click="CopyCookie_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock x:Name="StatusText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>