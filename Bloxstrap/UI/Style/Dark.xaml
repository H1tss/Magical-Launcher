<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#3A9CEA" />
    
    <!-- Unicorn Theme Resources -->
    <ImageBrush x:Key="UnicornBackgroundBrush" ImageSource="pack://application:,,,/Resources/UnicornWallpaper.jpg" Stretch="UniformToFill" Opacity="0.15" />
    <SolidColorBrush x:Key="UnicornCardBackground" Color="#1A1A2E" Opacity="0.7" />
    <SolidColorBrush x:Key="UnicornAccentPink" Color="#FF69B4" />
    <SolidColorBrush x:Key="UnicornAccentLavender" Color="#E6E6FA" />
    <SolidColorBrush x:Key="UnicornAccentMint" Color="#98FF98" />
</ResourceDictionary>